# Copy to api/.env and fill in real values locally. Never commit api/.env.
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# xAI key used by src/response/grok_client.py
XAI_API_KEY=
# Comma-separated browser origins. Use * only for a public demo.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional
GROK_MODEL=grok-3
FIRMS_DAY_RANGE=2
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
HOTSPOT_CACHE_SECONDS=600
WEATHER_CACHE_SECONDS=1800
HTTP_TIMEOUT_SECONDS=30
