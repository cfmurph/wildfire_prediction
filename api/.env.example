# Copy to api/.env and fill in real values locally. Never commit api/.env.
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Local development only: browser origins allowed to call the API from `next dev`. Production serves the web app from the same origin.
CORS_ORIGINS=http://localhost:3000
