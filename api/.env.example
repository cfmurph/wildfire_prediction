# Copy to api/.env and fill in real values locally. Never commit api/.env.
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# xAI key for POST /api/v1/situation
XAI_API_KEY=
# Comma-separated browser origins allowed to call the API (set to the Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
